# Google OAuth web application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The first beta administrator. This address is automatically activated and can
# invite or revoke other beta members from the in-app Setup panel.
BETA_ADMIN_EMAIL=

# Deprecated fallback retained for existing personal deployments. New setups
# should use BETA_ADMIN_EMAIL instead.
# ALLOWED_GMAIL_ADDRESS=

# A base64-encoded 32-byte key used to encrypt the Gmail refresh token.
# Generate one with: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Number of Gmail metadata records processed per Worker invocation. Keep this
# between 10 and 50. Start at 20 and increase only after checking Worker CPU.
SYNC_BATCH_SIZE=20
